# Tier 3: WebDriver UI smoke for soul-player, driven via tauri-driver over the
# real WebView2 runtime.
#
# DISABLED by default (the `.disabled` suffix means GitHub/Forgejo Actions
# ignore this file entirely). It needs a `windows-latest` runner with a
# WebView2 runtime + a matching msedgedriver, which isn't reliably available
# in CI yet (see app/e2e/README.md). To enable once that's sorted out, rename
# this file to `webdriver.yml` and drop (or widen) the `workflow_dispatch`
# trigger below.
#
# Shape follows the official Tauri WebDriver CI example:
# https://tauri.app/develop/tests/webdriver/ci/

name: webdriver (windows, e2e smoke)

on:
  workflow_dispatch:

jobs:
  webdriver:
    name: webdriver (soul-player e2e, windows)
    runs-on: windows-latest
    steps:
      - uses: actions/checkout@v4

      - uses: actions/setup-node@v4
        with:
          node-version: 24

      - uses: dtolnay/rust-toolchain@stable

      - uses: Swatinem/rust-cache@v2
        with:
          workspaces: app/src-tauri

      - name: install tauri-driver
        run: cargo install tauri-driver --locked

      - name: install msedgedriver-tool
        run: cargo install --git https://github.com/chippers/msedgedriver-tool

      - name: fetch matching msedgedriver
        run: |
          msedgedriver-tool
          echo "$PWD" | Out-File -FilePath $env:GITHUB_PATH -Encoding utf8 -Append
        shell: pwsh

      - name: npm ci (app)
        working-directory: app
        run: npm ci

      - name: npm ci (app/e2e)
        working-directory: app/e2e
        run: npm ci

      - name: webdriver e2e smoke
        working-directory: app/e2e
        env:
          SOUL_PLAYER_OFFLINE: "1"
        # onPrepare (wdio.conf.ts) runs `tauri build --debug --no-bundle
        # --features e2e` to produce the WebDriver-friendly binary before the
        # suite drives it.
        run: npm test
