/target
**/*.rs.bk
/out.pcm

# Local tooling / session state (not part of the template)
/.claude/
/.pi/
# Python bytecode caches from the testdata helper scripts
**/__pycache__/

# HE-AACv2/PS conformance fixture — license-restricted (Coding Technologies
# DecoderCheck package), used for LOCAL PS dev verification only, NEVER committed.
/crates/soul-audio-core/testdata/ps-local.*
# ISO/IEC MPEG audio conformance vectors — ISO-copyright, used for LOCAL
# conformance verification only (tests/mp3_conformance.rs skips when absent),
# NEVER committed. Fetch with testdata/fetch-mp3-conformance.sh.
/testdata/mp3-conformance-local/
# IETF Opus test vectors (RFC 8251) — freely redistributable but ~300 MB
# extracted, used for LOCAL conformance verification only
# (tests/opus_conformance.rs's full_corpus skips when absent), never committed.
# Fetch with testdata/fetch-opus-conformance.sh.
/testdata/opus-conformance-local/
