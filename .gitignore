/crates/soul-audio-core/testdata/ps-local.*
# ISO/IEC MPEG audio conformance vectors — ISO-copyright, used for LOCAL
# conformance verification only (tests/mp3_conformance.rs skips when absent),
# NEVER committed. Fetch with testdata/fetch-mp3-conformance.sh.
/testdata/mp3-conformance-local/
